PORT=3001

# Your Dathost CS2 server details
RCON_HOST=your-server.dathost.net
RCON_PORT=27015
RCON_PASSWORD=your_rcon_password

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# A secret key to protect your API endpoints
API_SECRET=change_this_to_something_random

# Optional comma-separated maps to show in the panel, including workshop-installed map names
ADMINPLUS_MAPS=de_cache,workshop/123456789/example_map

# Optional comma-separated local or mounted server maps directories for auto-discovery
ADMINPLUS_MAP_DIRS=/run/user/1000/gvfs/ftp:host=your-server.dathost.net,user=your-user/maps
