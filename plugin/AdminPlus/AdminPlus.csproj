<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AdminPlus</AssemblyName>
    <RootNamespace>AdminPlus</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.367" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time stub of the SimpleAdmin API; Private=false keeps it out of the plugin folder. -->
    <ProjectReference Include="..\Stubs\CS2-SimpleAdminApi\CS2-SimpleAdminApi.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
